{# What goes at the top of the thread: the editor, a way in for guests, or why nobody can post. #}
{% set guestFollow = viewer.showSubscribe and viewer.subscribeNeedsEmail and not viewer.isSubscribed and not sharedCache|default(false) %}
{% if viewer.canComment and viewer.isLoggedIn %}
    {% include '_editor/form' with { editor: editor, form: 'create' } %}
{% elseif not viewer.isLoggedIn and not conversation.closedNotice and (viewer.canComment or viewer.loginUrl) %}
    <section class="comments__join" aria-labelledby="{{ instance }}-join-title">
        <h3 class="comments__join-title" id="{{ instance }}-join-title">{{ 'Join the conversation' | t('comments') }}</h3>
        <p class="comments__join-text">
            {% if viewer.canComment %}
                {{ 'Sign in to comment and hear about replies, or post as a guest.' | t('comments') }}
            {% else %}
                {{ conversation.guestNotice ?? 'Sign in to comment.' | t('comments') }}
            {% endif %}
        </p>
        <div class="comments__join-actions">
            {% if viewer.loginUrl %}
                <a class="comments__button comments__button--primary" href="{{ viewer.loginUrl }}">{{ 'Sign in' | t('comments') }}</a>
            {% endif %}
            {% if viewer.canComment %}
                {# Works without JavaScript: the guest form opens in place. #}
                <details class="comments__join-guest">
                    <summary class="comments__button comments__button--quiet">{{ 'Comment as a guest' | t('comments') }}</summary>
                    {% include '_editor/form' with { editor: editor, form: 'create' } %}
                </details>
            {% endif %}
            {% if guestFollow %}
                {% include '_conversation/follow-by-email' %}
            {% endif %}
        </div>
    </section>
{% else %}
    {% include '_conversation/notice' %}

    {# Closed, or no way in: a guest can still follow from here. #}
    {% if guestFollow %}
        <div class="comments__join-actions">
            {% include '_conversation/follow-by-email' %}
        </div>
    {% endif %}
{% endif %}
