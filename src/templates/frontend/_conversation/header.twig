<header class="comments__header" data-comments-region="header">
    <div class="comments__header-main">
        <h2 class="comments__heading" tabindex="-1">
            {{ 'Comments' | t('comments') }}
            {% if conversation.commentCount > 0 %}
                <span class="comments__count"><span class="comments__visually-hidden">: </span>{{ conversation.commentCount | number }}</span>
            {% endif %}
        </h2>

        <nav class="comments__sort" aria-label="{{ 'Sort comments' | t('comments') }}">
            {% set sorts = conversation.allowsTopSort ? { top: 'Top' | t('comments'), newest: 'Newest' | t('comments'), oldest: 'Oldest' | t('comments') } : { newest: 'Newest' | t('comments'), oldest: 'Oldest' | t('comments') } %}
            {% for value, label in sorts %}
                <a
                    class="comments__sort-option"
                    href="?{{ conversation.pageParams | merge({ commentsSort: value }) | url_encode }}"
                    data-comments-action="sort"
                    data-comments-sort="{{ value }}"
                    {% if conversation.sort == value %}aria-current="true"{% endif %}
                >{{ label }}</a>
            {% endfor %}
        </nav>

        {# A guest who'd need to give an address follows from the Join card instead, below. #}
        {% if viewer.showSubscribe and not sharedCache|default(false) and (viewer.isSubscribed or not viewer.subscribeNeedsEmail) %}
            {% include '_conversation/subscribe' %}
        {% endif %}
    </div>

    {% if conversation.isModerator and not sharedCache|default(false) and (conversation.heldCount or conversation.reportedCount) %}
        <div class="comments__moderator-bar" role="note">
            <p>
                <strong>{{ 'Moderator view.' | t('comments') }}</strong>
                {% set parts = [] %}
                {% if conversation.heldCount %}{% set parts = parts | merge([conversation.heldCount == 1 ? '1 held' | t('comments') : '{count} held' | t('comments', { count: conversation.heldCount })]) %}{% endif %}
                {% if conversation.reportedCount %}{% set parts = parts | merge([conversation.reportedCount == 1 ? '1 reported' | t('comments') : '{count} reported' | t('comments', { count: conversation.reportedCount })]) %}{% endif %}
                {{ parts | join(' · ') }} {{ 'on this page' | t('comments') }}
            </p>
            <div class="comments__moderator-bar-actions">
                {% if conversation.heldCount %}
                    <button
                        type="button"
                        class="comments__button comments__button--quiet"
                        data-comments-action="toggle-held"
                        data-comments-js-only
                        aria-pressed="false"
                        data-comments-label-hide="{{ 'Hide held' | t('comments') }}"
                        data-comments-label-show="{{ 'Show held' | t('comments') }}"
                    >{{ 'Hide held' | t('comments') }}</button>
                {% endif %}
                {% if conversation.reviewUrl %}
                    <a class="comments__button comments__button--quiet" href="{{ conversation.reviewUrl }}" target="_blank" rel="noopener">{{ 'Review in Comments' | t('comments') }}</a>
                {% endif %}
            </div>
        </div>
    {% endif %}
</header>
