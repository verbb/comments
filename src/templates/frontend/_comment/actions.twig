{% set interaction = comment.interaction %}
{% set menuModeration = comment.moderatorOnly or comment.reported ? [] : comment.moderationActions %}
{% set hasMenu = 'edit' in comment.actions or 'remove' in comment.actions or 'report' in comment.actions or menuModeration or comment.state == 'approved' %}

{% if comment.actions or interaction or hasMenu %}
    <div class="comments__actions">
        {% if interaction %}
            {# Quiet by default: counts only show once there's something to count. #}
            <div class="comments__interactions" data-comments-interaction-mode="{{ interaction.mode }}">
                {% if 'interact' in comment.actions %}
                    <form method="post" action="{{ conversation.voteAction }}" class="comments__vote-form">
                        {{ csrfInput() }}
                        <input type="hidden" name="commentId" value="{{ comment.id }}">
                        <input type="hidden" name="type" value="upvote">
                        <input type="hidden" name="upvote" value="1">
                        <button
                            type="submit"
                            class="comments__vote comments__vote--up"
                            data-comments-action="interact"
                            data-comments-interaction-type="upvote"
                            data-comments-comment-uid="{{ comment.uid }}"
                            aria-pressed="{{ interaction.viewer == 'upvote' ? 'true' : 'false' }}"
                        >
                            {% if interaction.allowsDownvote %}
                                <svg class="comments__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4l5 6h-3v6H8v-6H5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                            {% else %}
                                <svg class="comments__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16.5s-6-3.6-6-8A3.4 3.4 0 0 1 10 6a3.4 3.4 0 0 1 6 2.5c0 4.4-6 8-6 8z" fill="currentColor" fill-opacity="{{ interaction.viewer == 'upvote' ? '1' : '0' }}" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                            {% endif %}
                            <span class="comments__visually-hidden">{{ interaction.allowsDownvote ? 'Upvote' | t('comments') : 'Like' | t('comments') }}</span>
                            {% if interaction.upvotes > 0 %}<span class="comments__vote-count">{{ interaction.upvotes }}</span>{% endif %}
                        </button>
                    </form>
                {% elseif not interaction.usesScore and interaction.upvotes > 0 %}
                    {# Someone who can't like still sees the count as the Like button shows it, just not pressable. #}
                    <span class="comments__vote-total">
                        <svg class="comments__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16.5s-6-3.6-6-8A3.4 3.4 0 0 1 10 6a3.4 3.4 0 0 1 6 2.5c0 4.4-6 8-6 8z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                        <span class="comments__visually-hidden">{{ 'Likes' | t('comments') }}: </span>
                        <span class="comments__vote-count">{{ interaction.upvotes }}</span>
                    </span>
                {% endif %}

                {% if 'interact-down' in comment.actions %}
                    <form method="post" action="{{ conversation.voteAction }}" class="comments__vote-form">
                        {{ csrfInput() }}
                        <input type="hidden" name="commentId" value="{{ comment.id }}">
                        <input type="hidden" name="type" value="downvote">
                        <input type="hidden" name="upvote" value="0">
                        <button
                            type="submit"
                            class="comments__vote comments__vote--down"
                            data-comments-action="interact"
                            data-comments-interaction-type="downvote"
                            data-comments-comment-uid="{{ comment.uid }}"
                            aria-pressed="{{ interaction.viewer == 'downvote' ? 'true' : 'false' }}"
                        >
                            <svg class="comments__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16l5-6h-3V4H8v6H5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                            <span class="comments__visually-hidden">{{ 'Downvote' | t('comments') }}</span>
                            {% if interaction.downvotes > 0 %}<span class="comments__vote-count">{{ interaction.downvotes }}</span>{% endif %}
                        </button>
                    </form>
                {% endif %}

                {% if interaction.usesScore and interaction.score != 0 %}
                    <span class="comments__score"><span class="comments__visually-hidden">{{ 'Score' | t('comments') }}: </span>{{ interaction.score }}</span>
                {% endif %}
            </div>
        {% endif %}

        {% if 'reply' in comment.actions %}
            <button type="button" class="comments__action" data-comments-action="reply" data-comments-comment-uid="{{ comment.uid }}" data-comments-js-only>
                <svg class="comments__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M8 5L3.5 9.5 8 14M4 9.5h7.5a5 5 0 0 1 5 5v1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ 'Reply' | t('comments') }}
            </button>
            <noscript><a class="comments__action-link" href="{{ comment.hrefs.reply }}">{{ 'Reply' | t('comments') }}</a></noscript>
        {% endif %}

        {% if hasMenu %}
            {# A disclosure, so it opens without JavaScript too. #}
            <details class="comments__menu">
                <summary class="comments__action comments__menu-toggle">
                    <span aria-hidden="true">···</span>
                    <span class="comments__visually-hidden">{{ 'More actions' | t('comments') }}</span>
                </summary>
                <div class="comments__menu-items">
                    {% if comment.state == 'approved' %}
                        <button type="button" class="comments__menu-item" data-comments-action="copy-link" data-comments-link="{{ comment.permalink }}" data-comments-js-only>{{ 'Copy link' | t('comments') }}</button>
                    {% endif %}

                    {% if 'edit' in comment.actions %}
                        <button type="button" class="comments__menu-item" data-comments-action="edit" data-comments-comment-uid="{{ comment.uid }}" data-comments-js-only>{{ 'Edit' | t('comments') }}</button>
                        <noscript><a class="comments__menu-item" href="{{ comment.hrefs.edit }}">{{ 'Edit' | t('comments') }}</a></noscript>
                    {% endif %}

                    {% if 'report' in comment.actions %}
                        <button type="button" class="comments__menu-item" data-comments-action="report" data-comments-comment-uid="{{ comment.uid }}" data-comments-js-only>{{ 'Report…' | t('comments') }}</button>
                        <noscript><a class="comments__menu-item" href="{{ comment.hrefs.flag }}">{{ 'Report…' | t('comments') }}</a></noscript>
                    {% endif %}

                    {% if 'remove' in comment.actions %}
                        <form method="post" action="{{ conversation.removeAction }}" class="comments__remove-form">
                            {{ csrfInput() }}
                            <input type="hidden" name="commentId" value="{{ comment.id }}">
                            <button
                                type="submit"
                                class="comments__menu-item comments__menu-item--danger"
                                data-comments-action="remove"
                                data-comments-comment-uid="{{ comment.uid }}"
                                data-comments-confirm="{{ 'Delete this comment? This can’t be undone.' | t('comments') }}"
                            >{{ 'Delete' | t('comments') }}</button>
                        </form>
                    {% endif %}

                    {% for moderationAction in menuModeration %}
                        <form method="post" action="{{ conversation.moderateAction }}" class="comments__moderate-form">
                            {{ csrfInput() }}
                            <input type="hidden" name="commentId" value="{{ comment.id }}">
                            <input type="hidden" name="moderationAction" value="{{ moderationAction }}">
                            <button
                                type="submit"
                                class="comments__menu-item comments__menu-item--danger"
                                data-comments-action="moderate"
                                data-comments-moderation-action="{{ moderationAction }}"
                                data-comments-comment-uid="{{ comment.uid }}"
                            >{{ { 'moderate-remove': 'Remove (moderator)' | t('comments'), 'moderate-spam': 'Mark as spam (moderator)' | t('comments') }[moderationAction] ?? moderationAction }}</button>
                        </form>
                    {% endfor %}
                </div>
            </details>
        {% endif %}
    </div>
{% endif %}
