{% set moderationLabels = {
    'moderate-approve': 'Approve' | t('comments'),
    'moderate-keep': 'Keep' | t('comments'),
    'moderate-remove': 'Remove' | t('comments'),
    'moderate-restore': 'Restore' | t('comments'),
    'moderate-spam': 'Spam' | t('comments'),
    'moderate-not-spam': 'Not spam' | t('comments'),
} %}
{% set inline = comment.moderationActions | filter(a => comment.moderatorOnly or comment.reported) %}

{# Each state has its own icon: waiting, spam, reported or removed. #}
{% set reviewIcons = {
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    spam: '<path d="M7.9 2h8.2L22 7.9v8.2L16.1 22H7.9L2 16.1V7.9z"/><path d="M12 8v4M12 16h.01"/>',
    flag: '<path d="M4 22V4c3-2 6-1 8 0s5 2 8 0v10c-3 2-6 1-8 0s-5-2-8 0"/>',
    removed: '<path d="M10.7 5.1A10 10 0 0 1 12 5c7 0 10 7 10 7a13 13 0 0 1-1.7 2.7M6.6 6.6A13.5 13.5 0 0 0 2 12s3 7 10 7a9.7 9.7 0 0 0 5.4-1.6M2 2l20 20M9.9 9.9a3 3 0 0 0 4.2 4.2"/>',
} %}
{% set reviewIcon = comment.reported and comment.state == 'approved' ? 'flag' : ({ spam: 'spam', removed: 'removed' }[comment.state] ?? 'clock') %}

<div class="comments__review" data-comments-state-badge="{{ comment.state }}">
    <p class="comments__review-label">
        <svg class="comments__icon comments__icon--{{ reviewIcon }}" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ reviewIcons[reviewIcon] | raw }}</svg>
        {{ comment.reviewLabel ?? ({ removed: 'Removed · only moderators see this' | t('comments') }[comment.state] ?? '') }}
    </p>

    {% if inline %}
        <div class="comments__moderation-actions" role="group" aria-label="{{ 'Moderation' | t('comments') }}">
            {% for moderationAction in inline %}
                <form method="post" action="{{ conversation.moderateAction }}" class="comments__moderate-form">
                    {{ csrfInput() }}
                    <input type="hidden" name="commentId" value="{{ comment.id }}">
                    <input type="hidden" name="moderationAction" value="{{ moderationAction }}">
                    <button
                        type="submit"
                        class="comments__button {{ loop.first ? 'comments__button--primary' : 'comments__button--quiet' }}"
                        data-comments-action="moderate"
                        data-comments-moderation-action="{{ moderationAction }}"
                        data-comments-comment-uid="{{ comment.uid }}"
                    >{{ moderationLabels[moderationAction] ?? moderationAction }}</button>
                </form>
            {% endfor %}
        </div>
    {% endif %}
</div>
