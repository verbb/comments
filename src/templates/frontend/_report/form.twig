{# Opened by the server when JavaScript isn't running, where it shows in the page instead. #}
<dialog class="comments__report-dialog" data-comments-report-dialog aria-labelledby="{{ instance }}-report-title" {% if reportTargetId ?? false %}open{% endif %}>
    <form
        class="comments__report-form"
        method="post"
        action="{{ conversation.reportAction }}"
        data-comments-form="report"
    >
        {{ csrfInput() }}
        <input type="hidden" name="commentId" value="{{ reportTargetId ?? '' }}">

        <div class="comments__report-header">
            <h3 class="comments__report-title" id="{{ instance }}-report-title">{{ 'Report this comment' | t('comments') }}</h3>
            <button type="button" class="comments__report-close" data-comments-action="cancel-report" data-comments-js-only aria-label="{{ 'Close' | t('comments') }}">×</button>
        </div>

        {# Filled in with the comment being reported, so it's clear which one this is. #}
        <blockquote class="comments__report-quote" data-comments-report-quote hidden></blockquote>

        <fieldset class="comments__report-fields">
            <legend class="comments__label">{{ 'What’s wrong with it?' | t('comments') }}</legend>

            {% for option in reportReasons %}
                <label class="comments__report-reason" for="{{ instance }}-report-reason-{{ loop.index }}">
                    <input id="{{ instance }}-report-reason-{{ loop.index }}" type="radio" name="reason" value="{{ option.value }}" required>
                    <span>
                        <span class="comments__report-reason-label">{{ option.label }}</span>
                        {% if option.description ?? false %}<span class="comments__report-reason-description">{{ option.description }}</span>{% endif %}
                    </span>
                </label>
            {% endfor %}
        </fieldset>

        <label class="comments__field" for="{{ instance }}-report-details">
            <span class="comments__label">{{ 'Anything else?' | t('comments') }}</span>
            <span class="comments__field-instructions">{{ 'Optional. Only moderators see this.' | t('comments') }}</span>
            <textarea id="{{ instance }}-report-details" name="details" rows="3"></textarea>
        </label>

        <div class="comments__report-actions">
            <button type="button" class="comments__button comments__button--quiet" data-comments-action="cancel-report" data-comments-js-only>{{ 'Cancel' | t('comments') }}</button>
            <noscript><a class="comments__action-link" href="{{ conversation.cancelHref }}">{{ 'Cancel' | t('comments') }}</a></noscript>
            <button class="comments__submit" type="submit">{{ 'Send report' | t('comments') }}</button>
        </div>
    </form>
</dialog>
