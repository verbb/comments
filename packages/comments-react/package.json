{
    "name": "@verbb/comments-react",
    "version": "4.0.0-beta.1",
    "description": "React components and hooks for Comments threads, with a provider, component part overrides, hooks for your own interface and server helpers.",
    "keywords": [
        "craftcms",
        "comments",
        "react"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE.md"
    ],
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "Verbb",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/verbb/comments.git",
        "directory": "packages/comments-react"
    },
    "bugs": {
        "url": "https://github.com/verbb/comments/issues"
    },
    "homepage": "https://docs.verbb.io/comments",
    "engines": {
        "node": ">=20.0.0"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
        "test": "vitest run",
        "test:browser": "node tests/browser/run.mjs"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "dependencies": {
        "@verbb/comments-browser": "4.0.0-beta.1",
        "@verbb/comments-core": "4.0.0-beta.1",
        "@verbb/editor": "^1.0.0",
        "@verbb/protect": "^1.0.0"
    },
    "devDependencies": {
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "16.3.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "happy-dom": "21.0.4",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "typescript": "^5.7.3",
        "vite": "^8.3.5",
        "vitest": "4.1.11"
    }
}
