{% apply spaceless %}
<section
    class="comments"
    data-comments-csrf-param="{{ craft.app.config.general.csrfTokenName }}"
    data-comments-root
    data-comments-contract="{{ contractVersion }}"
    data-comments-instance="{{ instance }}"
    data-comments-conversation-uid="{{ conversation.conversationUid }}"
    data-comments-owner-id="{{ conversation.ownerId }}"
    data-comments-site-id="{{ conversation.siteId }}"
    data-comments-theme="{{ theme }}"
    data-comments-api-base="{{ apiBase }}"
    data-comments-sort="{{ conversation.sort }}"
    data-comments-limit="{{ conversation.rootLimit }}"
    data-comments-enhanced="1"
    data-comments-discard-message="{{ 'Discard what you’ve written?' | t('comments') }}"
    data-comments-copied-message="{{ 'Link copied.' | t('comments') }}"
    data-comments-failed-message="{{ 'Something went wrong. Your comment hasn’t been lost, so please try again.' | t('comments') }}"
    data-comments-retry-label="{{ 'Try again' | t('comments') }}"
    data-comments-uploading-message="{{ 'Please wait for your upload to finish.' | t('comments') }}"
    {% if sharedCache %}data-comments-shared-cache="1"{% endif %}
    {% if conversation.lazy %}data-comments-lazy="1"{% endif %}
    {% if editorAsset ?? false %}data-comments-editor-module="{{ editorAsset.module }}" data-comments-editor-css="{{ editorAsset.css }}"{% endif %}
    aria-label="{{ 'Comments' | t('comments') }}"
    id="{{ instance }}"
>
    <div data-comments-region="live" class="comments__live" role="status" aria-live="polite" aria-atomic="true"></div>

    {% include '_conversation/header' %}

    {# The composer comes first, so joining in doesn't mean scrolling past everything. #}
    <div data-comments-region="composer"{% if sharedCache %} data-comments-private-hydrate="1"{% endif %}>
        {% if not sharedCache %}
            {% include '_composer/region' %}
        {% endif %}
    </div>

    <div data-comments-region="list">
        {% include '_conversation/list' %}
    </div>

    <div data-comments-region="feedback">
        {% include '_shared/feedback' %}
    </div>

    <div data-comments-region="report-dialog">
        {% if not sharedCache %}
            {% include '_report/form' %}
        {% endif %}
    </div>
</section>
{% endapply %}
