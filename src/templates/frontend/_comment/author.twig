<div class="comments__author">
    {% if comment.authorAvatarUrl %}
        <img
            class="comments__avatar"
            src="{{ comment.authorAvatarUrl }}"
            alt=""
            width="32"
            height="32"
            loading="lazy"
        >
    {% else %}
        <span class="comments__avatar comments__avatar--initials" data-tone="{{ comment.avatarTone }}" aria-hidden="true">{{ comment.authorInitials }}</span>
    {% endif %}

    <div class="comments__author-meta">
        {% if comment.authorName %}
            <span class="comments__author-name">{{ comment.authorName }}</span>
        {% endif %}

        {% for badge in comment.badges %}
            <span class="comments__badge comments__badge--{{ badge.type }}">{{ badge.label }}</span>
        {% endfor %}

        {% if comment.commentDate %}
            {# The date links to the comment, which is how people find a comment's address. With
               JavaScript, tapping it shows the full date instead, and the menu copies the link. #}
            <a class="comments__permalink" href="{{ comment.permalink }}" data-comments-action="toggle-date" data-comments-full-date="{{ comment.fullDate }}">
                <time class="comments__date" datetime="{{ comment.commentDate }}" title="{{ comment.fullDate }}">{{ comment.timeAgo ?? comment.fullDate }}</time>
            </a>
        {% endif %}

        {% for item in comment.metaLine ?? [] %}
            <span class="comments__meta-item">{{ item }}</span>
        {% endfor %}

        {% if comment.editedAt %}
            <span class="comments__edited" title="{{ comment.editedAt | date('short') }} {{ comment.editedAt | time('short') }}">{{ 'Edited' | t('comments') }}</span>
        {% endif %}
    </div>
</div>
