<li
    class="comments__comment{% if comment.moderatorOnly and not comment.placeholder %} comments__comment--held{% endif %}{% if comment.reported %} comments__comment--reported{% endif %}"
    data-comments-comment
    data-comments-comment-uid="{{ comment.uid }}"
    data-comments-comment-id="{{ comment.id }}"
    data-comments-depth="{{ comment.depth }}"
    data-comments-visual-depth="{{ comment.visualDepth }}"
    data-comments-state="{{ comment.state }}"
>
    <article
        id="comment-{{ comment.id }}"
        tabindex="-1"
        {% if not comment.placeholder %}aria-label="{{ 'Comment by {name}' | t('comments', { name: comment.authorName ?? 'Guest' }) }}"{% endif %}
    >
        {% if comment.placeholder %}
            <p class="comments__placeholder">{{ 'Comment unavailable.' | t('comments') }}</p>
        {% else %}
        {% include '_comment/author' %}
        {% include '_comment/content' %}
        {% include '_comment/actions' %}
        {% if comment.reviewLabel or comment.moderatorOnly %}
            {# Only reachable when the viewer can moderate: public reads never return these states. #}
            {% include '_comment/review' %}
        {% endif %}
        <div
            class="comments__contextual-editor"
            data-comments-region="contextual-editor"
            data-comments-comment-uid="{{ comment.uid }}"
        >
            {% if comment.contextualEditor %}
                {% include '_editor/form' with { editor: comment.contextualEditor, form: comment.contextualEditor.mode } %}
            {% endif %}
        </div>
        {% endif %}
        {% include '_comment/replies' %}
    </article>
</li>
