{# Follow or stop following. A guest gives an address, which they confirm before anything is sent. #}
<form
    class="comments__subscribe-form"
    method="post"
    action="{{ conversation.subscribeAction }}"
    data-comments-form="subscribe"
>
    {{ csrfInput() }}
    <input type="hidden" name="ownerId" value="{{ conversation.ownerId }}">
    <input type="hidden" name="siteId" value="{{ conversation.siteId }}">
    <input type="hidden" name="subscribed" value="{{ viewer.isSubscribed ? '0' : '1' }}">
    {% if viewer.subscribeNeedsEmail and not viewer.isSubscribed %}
        <label class="comments__field" for="{{ instance }}-subscribe-email">
            <span class="comments__field-label">{{ 'Your email' | t('comments') }}</span>
            <input
                id="{{ instance }}-subscribe-email"
                class="comments__input"
                name="email"
                type="email"
                autocomplete="email"
                required
            >
        </label>
    {% endif %}
    <button
        type="submit"
        class="comments__subscribe"
        data-comments-action="subscribe"
        aria-pressed="{{ viewer.isSubscribed ? 'true' : 'false' }}"
    >
        <svg class="comments__icon comments__icon--bell" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        {{ viewer.isSubscribed ? 'Following' | t('comments') : 'Follow' | t('comments') }}
    </button>
</form>
